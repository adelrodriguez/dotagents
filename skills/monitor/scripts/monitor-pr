#!/usr/bin/env python3
"""monitor-pr: watch a GitHub pull request until it is ready, one line per event.

  monitor-pr <pr> [--repo owner/name] [--until ready|green] [--head <sha>]
                [--require <agents>|none] [--interval 30s] [--stall 15m]
  monitor-pr show <pr> [--repo owner/name] [--require <agents>|none]
  monitor-pr threads list <pr> [--repo owner/name] [--json]
  monitor-pr threads reply <thread-id> --body-file <file|-> [--resolve]
  monitor-pr threads resolve <thread-id>...

<pr> is a PR number or URL. Without --repo, the repo comes from the URL or the
current checkout. A thread ID looks like PRRT_kwDO...; `threads list` prints it.

The thread commands work with any watcher. `threads reply` refuses a body
without the agent marker ("on behalf of"), so replies always say an agent
wrote them. `threads resolve` resolves every given thread in one request.

Stdout carries only events, one line each, so a monitor wakes the agent once
per event. Progress goes to stderr. `show` prints the current state once, with
the full text of every open finding and the IDs needed to reply and resolve.

--until
  ready   required checks pass, every review agent approved the head, no review
          thread is unresolved, and the branch is mergeable (default)
  green   required checks pass (every CI check when the base requires none)

--head <sha>
  After a push, ignore the PR until GitHub reports <sha> as its head.

--require <agents>
  Comma-separated review agents that must approve: pullfrog, codex, coderabbit,
  greptile, macroscope, bugbot, or a bot login. Defaults to every review agent
  that engaged with this PR or with any of the repo's last 10 merged PRs, so a
  slow agent is expected before it shows up. `none` waits for checks and
  threads only.

Review agents approve the head with an approving review, a passing verdict
check, or a comment that reports no remaining issues for that commit. Findings,
silence, and resolved threads are not approval.

Exit codes
  0  the --until condition is met, or the PR merged
  1  you need to act: a required check failed, the branch conflicts, a review
     agent left findings or went quiet, threads are unresolved, the branch is
     BEHIND a base that requires up-to-date branches, the PR closed, or GitHub
     stayed unreachable
  2  bad arguments, unknown PR, or another monitor-pr already watches this PR

Events
  - a check failed (name, link, and the command to read its logs)
  - all checks finished on the head (one summary line)
  - a review agent approved, left findings, or failed on the head
  - a review agent went quiet on the head (--stall), with how to re-request it
  - a comment, review, thread, or reply from a person, including your own
    comments that lack the agent marker ("on behalf of")
  - the base branch moved and the new commits touch files in this PR
  - merge state became BEHIND or DIRTY
  - the PR merged or closed

State lives in ~/.local/state/monitor-pr/. A lock makes a second watcher for the
same PR exit at once. The state file lets a restarted watcher report only what
arrived since the last report. On the first run, the watcher reports what is
open on the current head and skips the history of older heads.
"""

from __future__ import annotations

import argparse
import fcntl
import html
import json
import os
import re
import subprocess
import sys
import time
from collections import Counter
from collections.abc import Iterable
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Any, NoReturn

Json = dict[str, Any]


@dataclass(frozen=True)
class Agent:
    """A review agent: the logins it posts as, its check names, how to re-request it."""

    name: str
    logins: tuple[str, ...]
    checks: tuple[str, ...] = ()
    trigger: str = ""
    # Codex reacts 👍 to the PR instead of reviewing when it finds nothing.
    thumbs_up_approves: bool = False


AGENTS = (
    Agent("pullfrog", ("pullfrog",), ("pullfrog",), "@pullfrog review"),
    Agent("codex", ("chatgpt-codex-connector",), trigger="@codex review", thumbs_up_approves=True),
    Agent("coderabbit", ("coderabbitai",), ("coderabbit",), "@coderabbitai review"),
    Agent("greptile", ("greptile-apps",), ("greptile",), "@greptileai review"),
    Agent("macroscope", ("macroscopeapp", "macroscope-app"), ("macroscope",)),
    Agent("bugbot", ("cursor",), ("cursor bugbot",), "@cursor review"),
)

# Verdicts in each agent's own wording. Findings win when a text has both, as in
# "No new issues were found. The existing issue remains, so I cannot approve."
FINDINGS = re.compile(
    r"cannot approve|would not approve|would request changes|found [1-9]\d* potential issues?|"
    r"actionable comments posted:\s*[1-9]|confidence score:?\s*[0-4]\s*/\s*5|\b[1-9]\d* comments? added",
    re.IGNORECASE,
)
APPROVAL = re.compile(
    r"no new issues|no issues found|didn'?t find any major issues|no actionable (comments|issues)|"
    r"actionable comments posted:\s*0\b|would approve|confidence score:?\s*5\s*/\s*5|\b0 comments added|\blgtm\b",
    re.IGNORECASE,
)
RUN_FAILED = re.compile(r"\brun failed\b|review failed|this review did not happen|token expired or was revoked", re.IGNORECASE)
# Agents edit one progress comment in place. Only its final form is a verdict.
PROGRESS = re.compile(r"leaping into action|^\s*-\s\[ \]|\bin progress\b|working on (it|this)|reviewing\.\.\.|⏳", re.IGNORECASE | re.MULTILINE)
# Posts the agent makes on the user's behalf. See the comment-on-github skill.
AGENT_MARK = re.compile(r"on behalf of ", re.IGNORECASE)
REVIEW_REQUEST = re.compile(r"^\s*@[\w-]+ review\b", re.IGNORECASE)
GRAPHITE_STACK = re.compile(r"app\.graphite\.(com|dev)/github/pr/")

FAILED_CONCLUSIONS = {"FAILURE", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE", "CANCELLED", "STALE"}
TRANSIENT = re.compile(
    r"HTTP (5\d\d)|timed? ?out|connection (reset|refused)|EOF|temporar|could not resolve host|"
    r"TLS handshake|Something went wrong",
    re.IGNORECASE,
)
RATE_LIMIT = re.compile(r"rate limit|HTTP 429", re.IGNORECASE)

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "monitor-pr"
# A state file older than this belongs to an old session. Start over instead of
# replaying hours of comments as new events.
STALE_STATE_SECONDS = 6 * 3600
MAX_FAILED_POLLS = 10
# Checks register a few seconds after a push. With no required checks to wait
# for, a head this young with no checks is not green yet.
CHECKS_GRACE_SECONDS = 120

QUERY = """
query($owner: String!, $name: String!, $number: Int!) {
  viewer { login }
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      url state headRefOid baseRefName mergeStateStatus
      baseRef { target { oid } }
      commits(last: 1) { nodes { commit { committedDate statusCheckRollup { contexts(first: 100) { nodes {
        __typename
        ... on CheckRun {
          name status conclusion title summary startedAt completedAt detailsUrl
          checkSuite { app { slug } }
        }
        ... on StatusContext { context state description targetUrl createdAt }
      } } } } } }
      reviews(last: 100) { nodes { databaseId url state body submittedAt commit { oid } author { login __typename } } }
      comments(last: 100) { nodes { databaseId url body createdAt lastEditedAt author { login __typename } } }
      reactions(last: 50) { nodes { content createdAt user { login } } }
      reviewThreads(last: 100) { nodes {
        id isResolved path line
        root: comments(first: 1) { nodes { databaseId } }
        recent: comments(last: 20) { nodes { databaseId url body createdAt author { login __typename } } }
      } }
    }
  }
}
"""


class GhError(Exception):
    def __init__(self, message: str, *, transient: bool = False, rate_limited: bool = False) -> None:
        super().__init__(message)
        self.transient = transient
        self.rate_limited = rate_limited


def log(message: str) -> None:
    print(f"monitor-pr: {message}", file=sys.stderr, flush=True)


def fail(message: str, code: int = 2) -> NoReturn:
    # Fatal messages go to stdout so a monitor shows the agent why it stopped.
    print(f"monitor-pr: {message}", flush=True)
    sys.exit(code)


def gh(*args: str, ok: tuple[int, ...] = (0,)) -> str:
    """Run gh, retrying network failures and 5xx responses with backoff."""
    delay = 2
    for attempt in range(5):
        proc = subprocess.run(["gh", *args], capture_output=True, text=True)
        if proc.returncode == 0:
            return proc.stdout
        lines = proc.stderr.strip().splitlines()
        message = lines[-1] if lines else f"gh exited {proc.returncode}"
        # Check for rate limits and 5xx errors first: those responses can carry a body too.
        if RATE_LIMIT.search(proc.stderr):
            raise GhError(message, rate_limited=True)
        transient = bool(TRANSIENT.search(proc.stderr))
        if not transient and proc.returncode in ok and proc.stdout.strip():
            return proc.stdout
        if not transient or attempt == 4:
            raise GhError(message, transient=transient)
        log(f"gh {' '.join(args[:2])}: {message}; retry in {delay}s")
        time.sleep(delay)
        delay *= 2
    raise AssertionError("unreachable")


def gh_lines(*args: str) -> list[str]:
    return [line for line in gh(*args).splitlines() if line]


def timestamp(value: str | None) -> float:
    return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp() if value else 0.0


def same_commit(a: str | None, b: str | None) -> bool:
    return bool(a and b) and min(len(a), len(b)) >= 7 and (a.startswith(b) or b.startswith(a))


def who(node: Json, key: str = "author") -> tuple[str, bool]:
    actor = node.get(key) or {}
    login = (actor.get("login") or "ghost").removesuffix("[bot]")
    return login, actor.get("__typename") == "Bot"


def plain(body: str | None) -> str:
    text = re.sub(r"<!--.*?-->", " ", body or "", flags=re.DOTALL)
    return html.unescape(re.sub(r"<[^>]+>", " ", text))


def snippet(body: str | None, limit: int = 140) -> str:
    text = re.sub(r"\s+", " ", plain(body).replace("*", "")).strip()
    return text if len(text) <= limit else text[: limit - 1] + "…"


def excerpt(body: str | None, limit: int = 3000) -> str:
    text = re.sub(r"\n{3,}", "\n\n", plain(body)).strip()
    return text if len(text) <= limit else f"{text[:limit]}… [{len(text) - limit} more chars]"


def classify(text: str) -> str | None:
    flat = plain(text).replace("*", "")
    if FINDINGS.search(flat):
        return "findings"
    if APPROVAL.search(flat):
        return "approved"
    if RUN_FAILED.search(flat):
        return "failed"
    return None


def reviewed_commit(body: str) -> str | None:
    """The commit a review summary names, as in "Reviewed commit: `abc1234`"."""
    after = re.search(r"reviewed commit(.{0,300})", body or "", re.IGNORECASE | re.DOTALL)
    sha = after and re.search(r"\b[0-9a-f]{7,40}\b", after.group(1))
    return sha.group(0) if sha else None


def marked(body: str | None) -> bool:
    """Whether a post from the user's account came from an agent."""
    return not (body or "").strip() or bool(AGENT_MARK.search(body or "") or REVIEW_REQUEST.match(body or ""))


def agent_named(name: str) -> Agent:
    return next((a for a in AGENTS if name in (a.name, *a.logins)), Agent(name, (name,)))


def agent_for(login: str) -> Agent | None:
    return next((a for a in AGENTS if login in a.logins), None)


@dataclass(frozen=True)
class Check:
    name: str
    state: str  # pending, pass, or fail
    url: str
    text: str
    started: float
    finished: float
    app: str

    @property
    def agent(self) -> Agent | None:
        return agent_for_check(self.name, self.app)


def agent_for_check(name: str, app: str) -> Agent | None:
    name = name.lower()
    return next((a for a in AGENTS if app in a.logins or (a.checks and name.startswith(a.checks))), None)


def read_checks(commit: Json) -> dict[str, Check]:
    """The head's checks by name. A re-run leaves the old run behind, so the newest run wins."""
    checks: dict[str, Check] = {}
    for node in ((commit.get("statusCheckRollup") or {}).get("contexts") or {}).get("nodes") or []:
        if node["__typename"] == "CheckRun":
            state = "pending" if node["status"] != "COMPLETED" else "fail" if node["conclusion"] in FAILED_CONCLUSIONS else "pass"
            check = Check(
                node["name"], state, node["detailsUrl"] or "", f"{node['title'] or ''}\n{node['summary'] or ''}",
                timestamp(node["startedAt"]), timestamp(node["completedAt"]), ((node["checkSuite"] or {}).get("app") or {}).get("slug") or "",
            )
        else:
            state = {"PENDING": "pending", "EXPECTED": "pending", "FAILURE": "fail", "ERROR": "fail"}.get(node["state"], "pass")
            started = timestamp(node["createdAt"])
            check = Check(node["context"], state, node["targetUrl"] or "", node["description"] or "", started, started, "")
        if check.name not in checks or check.started >= checks[check.name].started:
            checks[check.name] = check
    return checks


@dataclass(frozen=True)
class Verdict:
    at: float
    state: str  # approved, findings, or failed
    text: str
    url: str


@dataclass
class AgentStatus:
    agent: Agent
    state: str  # reviewing, approved, findings, failed, or waiting
    verdict: Verdict | None


@dataclass(frozen=True)
class Item:
    """Something a person or agent said. `current` items are reported on a first run too."""

    key: str
    line: str
    current: bool


@dataclass
class Status:
    pr: Json
    viewer: str
    head: str
    head_at: float
    ci: dict[str, Check]
    gate: dict[str, str]
    agents: list[AgentStatus]
    quiet_since: float
    items: list[Item]
    open_threads: list[Json]
    answered_threads: list[Json]


def analyze(pr: Json, viewer: str, required_checks: set[str], require: list[str] | None, expected: set[str]) -> Status:
    """Turn one snapshot of the PR into its checks, review agents, and conversation."""
    head = pr["headRefOid"]
    commit = pr["commits"]["nodes"][0]["commit"]
    head_at = timestamp(commit["committedDate"])
    checks = read_checks(commit)
    ci = {name: c for name, c in checks.items() if not c.agent}
    # With no required checks configured, every CI check gates.
    gate = {name: checks[name].state if name in checks else "pending" for name in required_checks} or {
        name: c.state for name, c in ci.items()
    }

    agents: dict[str, Agent] = {}
    verdicts: dict[str, list[Verdict]] = {}
    reviewing: set[str] = set()
    looking: dict[str, float] = {}  # agent -> latest 👀 on this head
    activity = [head_at, *(c.finished for c in ci.values())]

    def note(agent: Agent, at: float, state: str | None, text: str, url: str) -> None:
        agents[agent.name] = agent
        activity.append(at)
        if state:
            verdicts.setdefault(agent.name, []).append(Verdict(at, state, text, url))

    for check in checks.values():
        if agent := check.agent:
            if check.state == "pending":
                agents[agent.name] = agent
                reviewing.add(agent.name)
            else:
                state = classify(check.text) or ("findings" if check.state == "fail" else None)
                note(agent, check.finished, state, check.text, check.url)

    items: list[Item] = []
    for review in pr["reviews"]["nodes"]:
        login, is_bot = who(review)
        at, body, url = timestamp(review["submittedAt"]), review["body"] or "", review["url"]
        on_head = same_commit((review.get("commit") or {}).get("oid"), head)
        if is_bot:
            # Any bot that reviews is a review agent, known or not.
            agent = agent_for(login) or Agent(login, (login,))
            agents[agent.name] = agent
            if on_head:
                state = {"APPROVED": "approved", "CHANGES_REQUESTED": "findings"}.get(review["state"])
                note(agent, at, state or classify(body) or ("findings" if body.strip() else None), body, url)
        elif login != viewer and (body.strip() or review["state"] in ("APPROVED", "CHANGES_REQUESTED")):
            state = review["state"].lower().replace("_", " ")
            items.append(Item(f"c:{review['databaseId']}", f"review from {login} ({state}): {snippet(body)} {url}", on_head))

    for comment in pr["comments"]["nodes"]:
        login, is_bot = who(comment)
        body, url = comment["body"] or "", comment["url"]
        at = timestamp(comment["lastEditedAt"] or comment["createdAt"])
        if agent := agent_for(login):
            agents[agent.name] = agent
            sha = reviewed_commit(body)
            if not PROGRESS.search(body) and (same_commit(sha, head) if sha else at >= head_at):
                note(agent, at, classify(body), body, url)
            continue
        if is_bot:
            continue  # CI and deploy bots report through checks
        created = timestamp(comment["createdAt"])
        if login == viewer:
            # Your own unmarked comments are instructions when they are newer than the head.
            if marked(body) or created < head_at or GRAPHITE_STACK.search(body):
                continue
            login = "you (not agent-marked)"
        items.append(Item(f"c:{comment['databaseId']}", f"comment from {login}: {snippet(body)} {url}", created >= head_at))

    for reaction in pr["reactions"]["nodes"]:
        login, _ = who(reaction, "user")
        if not (agent := agent_for(login)):
            continue
        agents[agent.name] = agent
        at = timestamp(reaction["createdAt"])
        if at < head_at:
            continue
        if reaction["content"] == "EYES":
            looking[agent.name] = max(looking.get(agent.name, 0.0), at)
        approves = reaction["content"] == "THUMBS_UP" and agent.thumbs_up_approves
        note(agent, at, "approved" if approves else None, "reacted 👍 to the PR", pr["url"])

    open_threads: list[Json] = []
    answered_threads: list[Json] = []
    for thread in pr["reviewThreads"]["nodes"]:
        comments = thread["recent"]["nodes"]
        root = (thread["root"]["nodes"] or [{}])[0].get("databaseId")
        if not comments:
            continue
        last_login, _ = who(comments[-1])
        answered = last_login == viewer and marked(comments[-1]["body"])
        if not thread["isResolved"]:
            (answered_threads if answered else open_threads).append(thread)
        where = f"{thread['path']}:{thread['line']}" if thread["line"] else thread["path"]
        for comment in comments:
            login, _ = who(comment)
            body = comment["body"] or ""
            if login == viewer:
                if marked(body) or timestamp(comment["createdAt"]) < head_at:
                    continue
                login = "you (not agent-marked)"
            kind = "new thread" if comment["databaseId"] == root else "thread reply"
            line = (
                f"{kind} from {login} on {where}: {snippet(body)} {comment['url']} "
                f"(thread {thread['id']})"
            )
            items.append(Item(f"c:{comment['databaseId']}", line, not thread["isResolved"] and not answered))

    if require == ["none"]:
        required_agents: list[Agent] = []
    elif require:
        required_agents = [agents.get(agent_named(name).name) or agent_named(name) for name in require]
    else:
        # Agents that reviewed the repo's recent PRs are expected before they engage with this one.
        required_agents = [agents.get(name) or agent_named(name) for name in sorted(set(agents) | expected)]

    statuses: list[AgentStatus] = []
    for agent in required_agents:
        latest = max(verdicts.get(agent.name, []), key=lambda v: v.at, default=None)
        busy = agent.name in reviewing or looking.get(agent.name, 0.0) > (latest.at if latest else 0.0)
        statuses.append(AgentStatus(agent, "reviewing" if busy else latest.state if latest else "waiting", latest))

    return Status(
        pr, viewer, head, head_at, ci, gate, statuses, max(activity), items, open_threads, answered_threads,
    )


def summarize(status: Status, required_checks: set[str], require: list[str] | None) -> str:
    counts = Counter(c.state for c in status.ci.values())
    if status.agents:
        agents = ", ".join(f"{a.agent.name} {a.state}" for a in status.agents)
    else:
        agents = "none required" if require == ["none"] else "none engaged yet"
    threads = len(status.open_threads) + len(status.answered_threads)
    answered = f" ({len(status.answered_threads)} answered, resolve them)" if status.answered_threads else ""
    parts = [
        f"checks {counts['pass']} passed, {counts['fail']} failed, {counts['pending']} pending",
        f"required {sum(s == 'pass' for s in status.gate.values())}/{len(status.gate)} green" if required_checks else "",
        f"agents: {agents}",
        f"{threads} unresolved threads{answered}",
        f"merge state {status.pr['mergeStateStatus']}",
    ]
    return "; ".join(p for p in parts if p)


def logs_hint(repo: str, url: str) -> str:
    run = re.search(r"/actions/runs/(\d+)", url)
    return f" (logs: gh run view {run.group(1)} --log-failed -R {repo})" if run else ""


def request_hint(agent: Agent) -> str:
    if agent.trigger:
        return f'post "{agent.trigger}" with the agent marker'
    return "request a review through the repository's supported mechanism"


def parse_target(raw: str, repo: str | None) -> tuple[str, int]:
    url = re.fullmatch(r"https?://github\.com/([^/\s]+/[^/\s]+)/pull/(\d+)(?:[/?#]\S*)?", raw.strip())
    number = re.fullmatch(r"#?(\d+)", raw.strip())
    if url:
        repo, pr = repo or url.group(1), int(url.group(2))
    elif number:
        pr = int(number.group(1))
    else:
        fail(f"'{raw}' is not a PR number or PR URL")
    if not repo:
        try:
            repo = gh("repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner").strip()
        except GhError as error:
            fail(f"no --repo given and the current directory has no GitHub repo ({error})")
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo):
        fail(f"'{repo}' is not owner/name")
    try:
        gh("api", f"repos/{repo}/pulls/{pr}", "--jq", ".number")
    except GhError as error:
        if not (error.transient or error.rate_limited):  # the poll loop retries those
            fail(f"cannot read {repo}#{pr}: {error}")
    return repo, pr


def required_check_names(repo: str, base: str) -> set[str]:
    """Required checks from rulesets and classic branch protection. Knowing them up
    front makes a required check that has not started yet pending, not green by omission."""
    sources = (
        (
            f"repos/{repo}/rules/branches/{base}",
            '.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context',
        ),
        (f"repos/{repo}/branches/{base}/protection/required_status_checks", ".contexts[]?, .checks[]?.context"),
    )
    names: set[str] = set()
    for path, jq in sources:
        try:
            names.update(gh_lines("api", path, "--jq", jq))
        except GhError as error:
            if "HTTP 404" not in str(error):  # 404 means no protection, which is normal
                log(f"could not read required checks from {path}: {error}")
    return names


def fetch(repo: str, pr: int) -> tuple[Json, str]:
    owner, name = repo.split("/")
    # GraphQL errors exit 1 even when the response holds usable data.
    out = gh("api", "graphql", "-f", f"query={QUERY}", "-f", f"owner={owner}", "-f", f"name={name}", "-F", f"number={pr}", ok=(0, 1))
    try:
        body = json.loads(out)
    except ValueError:
        raise GhError("GitHub returned a response that is not JSON", transient=True) from None
    errors = body.get("errors") or []
    if any(e.get("type") == "RATE_LIMITED" for e in errors):
        raise GhError("GraphQL rate limit reached", rate_limited=True)
    data = body.get("data") or {}
    pull = (data.get("repository") or {}).get("pullRequest")
    if not pull:
        message = "; ".join(e.get("message", "") for e in errors) or "empty GraphQL response"
        raise GhError(message, transient=not errors or bool(TRANSIENT.search(message)))
    return pull, data["viewer"]["login"]


HISTORY_QUERY = """
query($owner: String!, $name: String!) {
  repository(owner: $owner, name: $name) {
    pullRequests(states: MERGED, first: 10, orderBy: {field: UPDATED_AT, direction: DESC}) { nodes {
      reviews(last: 30) { nodes { author { login __typename } } }
      comments(last: 30) { nodes { author { login } } }
      reactions(last: 20) { nodes { user { login } } }
      commits(last: 1) { nodes { commit { statusCheckRollup { contexts(first: 50) { nodes {
        __typename
        ... on CheckRun { name checkSuite { app { slug } } }
        ... on StatusContext { context }
      } } } } } }
    } }
  }
}
"""


def expected_agents(repo: str) -> set[str]:
    """Review agents that engaged with any of the repo's last 10 merged PRs, cached for a day."""
    cache = STATE_DIR / f"{repo.replace('/', '__')}.agents.json"
    try:
        if time.time() - cache.stat().st_mtime < 24 * 3600:
            return set(json.loads(cache.read_text()))
    except (OSError, ValueError):
        pass
    owner, name = repo.split("/")
    try:
        out = gh("api", "graphql", "-f", f"query={HISTORY_QUERY}", "-f", f"owner={owner}", "-f", f"name={name}")
        prs = json.loads(out)["data"]["repository"]["pullRequests"]["nodes"]
    except (GhError, ValueError, KeyError, TypeError) as error:
        log(f"could not read recent PRs to learn the repo's review agents: {error}")
        return set()
    found: set[str] = set()
    for pr in prs:
        for review in pr["reviews"]["nodes"]:
            login, is_bot = who(review)
            if agent := agent_for(login) or (Agent(login, (login,)) if is_bot else None):
                found.add(agent.name)
        logins = [who(c)[0] for c in pr["comments"]["nodes"]] + [who(r, "user")[0] for r in pr["reactions"]["nodes"]]
        found.update(agent.name for login in logins if (agent := agent_for(login)))
        for commit in pr["commits"]["nodes"]:
            for node in ((commit["commit"].get("statusCheckRollup") or {}).get("contexts") or {}).get("nodes") or []:
                app = ((node.get("checkSuite") or {}).get("app") or {}).get("slug") or ""
                if agent := agent_for_check(node.get("name") or node.get("context") or "", app):
                    found.add(agent.name)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps(sorted(found)))
    return found


def rate_limit_reset() -> float:
    """When the exhausted GitHub limit resets. The rate_limit endpoint costs nothing."""
    jq = "[.resources.graphql, .resources.core] | map(select(.remaining == 0) | .reset) | max // empty"
    try:
        return float(gh("api", "rate_limit", "--jq", jq).strip() or time.time() + 60)
    except (GhError, ValueError):
        return time.time() + 300


def lock(repo: str, pr: int) -> Any:
    """Hold a per-PR lock for the life of the process. The OS drops it on exit."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    handle = open(STATE_DIR / f"{repo.replace('/', '__')}__{pr}.lock", "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.seek(0)
        pid = handle.read().strip() or "unknown"
        fail(
            f"pid {pid} already watches {repo}#{pr}, so this watcher exits to avoid duplicate events. "
            f"If no events reach you from it, run `kill {pid}` and start again."
        )
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    return handle


class Watcher:
    def __init__(self, repo: str, pr: int, args: argparse.Namespace) -> None:
        self.repo, self.pr, self.args = repo, pr, args
        self.path = STATE_DIR / f"{repo.replace('/', '__')}__{pr}.json"
        state = self.load()
        # First run for this PR: report what is open on the head, not its history.
        self.first_run = state is None
        self.state: Json = state or {"reported": [], "base_oid": None, "merge_state": None}
        self.reported: set[str] = set(self.state["reported"])
        self.printed: set[str] = set()
        self.required: set[str] | None = None
        self.expected: set[str] = set()
        self.previous_ci: list[tuple[str, str]] | None = None
        self.pr_files: dict[str, set[str]] = {}

    def load(self) -> Json | None:
        try:
            if time.time() - self.path.stat().st_mtime > STALE_STATE_SECONDS:
                return None
            return json.loads(self.path.read_text())
        except (OSError, ValueError):
            return None

    def save(self) -> None:
        self.state["reported"] = sorted(self.reported)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state))
        tmp.replace(self.path)

    def say(self, line: str) -> None:
        if line not in self.printed:
            self.printed.add(line)
            print(f"#{self.pr} {line}", flush=True)

    def emit(self, key: str, line: str, current: bool = True) -> None:
        """Print an event once per PR, across restarts."""
        if key in self.reported:
            return
        self.reported.add(key)
        if current or not self.first_run:
            self.say(line)

    def finish(self, code: int, lines: Iterable[str] = ()) -> NoReturn:
        for line in lines:
            self.say(line)
        self.save()
        sys.exit(code)

    def files_overlap(self, head: str, old: str, new: str) -> list[str]:
        """Files this PR touches that the new base commits also touch."""
        try:
            if head not in self.pr_files:
                self.pr_files[head] = set(gh_lines("api", "--paginate", f"repos/{self.repo}/pulls/{self.pr}/files", "--jq", ".[].filename"))
            moved = gh_lines("api", f"repos/{self.repo}/compare/{old}...{new}", "--jq", ".files[].filename")
        except GhError as error:
            log(f"could not compare base commits: {error}")
            return []
        return sorted(self.pr_files[head].intersection(moved))

    def behind(self, base: str, base_oid: str | None, head: str) -> str:
        if not base_oid:
            return ""
        try:
            count = gh("api", f"repos/{self.repo}/compare/{base_oid}...{head}", "--jq", ".behind_by").strip()
        except GhError:
            return ""
        if count == "0":
            return f"; up to date with {base}"
        return f"; {count} commit{'' if count == '1' else 's'} behind {base}"

    def poll(self) -> None:
        pr, viewer = fetch(self.repo, self.pr)
        if pr["state"] == "MERGED":
            self.finish(0, [f"merged: {pr['url']}"])
        if pr["state"] == "CLOSED":
            self.finish(1, [f"closed without merging: {pr['url']}"])
        head, base = pr["headRefOid"], pr["baseRefName"]
        if self.args.head and not same_commit(head, self.args.head):
            log(f"waiting for head {self.args.head[:7]}; the PR head is still {head[:7]}")
            return
        if self.required is None:
            self.required = required_check_names(self.repo, base)
            gate = ", ".join(sorted(self.required)) or "none set, so every CI check gates"
            log(f"watching {self.repo}#{self.pr} until {self.args.until}; required checks: {gate}")
            self.expected = set() if self.args.require else expected_agents(self.repo)
            if self.expected:
                log(f"expected agents: {', '.join(sorted(self.expected))} (from the last 10 merged PRs)")

        status = analyze(pr, viewer, self.required, self.args.require, self.expected)
        short = head[:7]
        now = time.time()

        # Checks.
        failed = sorted(name for name, state in status.gate.items() if state == "fail")
        for name, check in sorted(status.ci.items()):
            if check.state == "fail":
                label = "required check" if name in self.required else "check"
                self.emit(f"fail:{head}:{name}:{check.url}", f"{label} failed: {name} {check.url}{logs_hint(self.repo, check.url)}")
        fail_lines = [f"check failed: {name} {status.ci[name].url if name in status.ci else ''}" for name in failed]
        # Two identical polls in a row guard against a half-registered set of checks.
        snapshot = sorted((name, c.state) for name, c in status.ci.items())
        stable, self.previous_ci = snapshot == self.previous_ci, snapshot
        young = not status.gate and now - status.head_at < CHECKS_GRACE_SECONDS
        gate_done = not young and all(state != "pending" for state in status.gate.values())
        green = gate_done and stable and not failed

        # People, and the review agents' verdicts on the head.
        for item in status.items:
            self.emit(item.key, item.line, item.current)
        for agent in status.agents:
            if agent.verdict and agent.state in ("approved", "findings", "failed"):
                v = agent.verdict
                self.emit(f"agent:{agent.agent.name}:{head}:{v.state}:{v.at}", f"{agent.agent.name} {v.state} on {short}: {snippet(v.text)} {v.url}")

        # Base branch and merge state.
        base_oid = ((pr.get("baseRef") or {}).get("target") or {}).get("oid")
        old_base = self.state["base_oid"]
        if base_oid and old_base and base_oid != old_base:
            touched = self.files_overlap(head, old_base, base_oid)
            if touched:
                more = f" and {len(touched) - 5} more" if len(touched) > 5 else ""
                self.emit(f"base:{base_oid}", f"{base} moved to {base_oid[:7]} and touches files in this PR: {', '.join(touched[:5])}{more}")
        self.state["base_oid"] = base_oid or old_base
        merge_state = pr["mergeStateStatus"]
        dirty_line = f"merge state is DIRTY: the branch conflicts with {base}; rebase it"
        behind_line = f"merge state is BEHIND: {base} requires up-to-date branches; rebase onto it"
        if merge_state != "UNKNOWN":
            if merge_state in ("BEHIND", "DIRTY") and self.state["merge_state"] != merge_state:
                self.emit(f"merge:{merge_state}:{head}:{base_oid}", dirty_line if merge_state == "DIRTY" else behind_line)
            self.state["merge_state"] = merge_state

        summary = summarize(status, self.required, self.args.require)
        if all(c.state != "pending" for c in status.ci.values()) and gate_done and stable:
            self.emit(f"checks:{head}", f"checks finished on {short}: {summary}")

        # Decide whether to stop.
        if merge_state == "DIRTY":
            self.finish(1, [dirty_line])
        if failed:
            self.finish(1, fail_lines)
        if not green:
            return
        if self.args.until == "green":
            self.finish(0, [f"green on {short}: {summary}{self.behind(base, base_oid, head)}"])

        quiet = now - status.quiet_since > self.args.stall
        silent = [a for a in status.agents if a.state == "waiting"]
        if any(a.state == "reviewing" for a in status.agents) or (silent and not quiet):
            return
        if not status.agents and self.args.require != ["none"] and not quiet:
            return
        problems = [
            *(f"{a.agent.name} left findings on {short}: {a.verdict.url}" for a in status.agents if a.state == "findings" and a.verdict),
            *(f"{a.agent.name} review failed on {short}; {request_hint(a.agent)}" for a in status.agents if a.state == "failed"),
            *(
                f"stalled: {a.agent.name} has not reviewed {short} after {round((now - status.quiet_since) / 60)}m; {request_hint(a.agent)}"
                for a in silent
            ),
        ]
        if not status.agents and self.args.require != ["none"]:
            problems.append(f"stalled: no review agent engaged with {short}; request a review, or rerun with --require none")
        if status.open_threads:
            urls = " ".join(t["recent"]["nodes"][-1]["url"] for t in status.open_threads)
            problems.append(f"{len(status.open_threads)} unresolved threads on {short}: {urls}")
        if status.answered_threads:
            problems.append(f"{len(status.answered_threads)} threads answered by you but unresolved; resolve them")
        if problems:
            self.finish(1, [f"blocked on {short}: {summary}", *problems])
        if merge_state == "BEHIND":
            self.finish(1, [behind_line])
        self.finish(0, [f"ready on {short}: {summary}{self.behind(base, base_oid, head)}"])

    def run(self) -> NoReturn:
        failures = 0
        while True:
            try:
                self.poll()
                failures = 0
            except GhError as error:
                if error.rate_limited:
                    reset = rate_limit_reset()
                    self.say(f"GitHub rate limit reached; resuming at {time.strftime('%H:%M', time.localtime(reset))}")
                    time.sleep(max(reset - time.time(), 0) + 5)
                    continue
                if not error.transient:
                    self.finish(1, [f"monitor-pr stopped: {error}"])
                failures += 1
                log(f"poll failed ({failures}/{MAX_FAILED_POLLS}): {error}")
                if failures >= MAX_FAILED_POLLS:
                    self.finish(1, [f"monitor-pr stopped: GitHub unreachable for {failures} polls: {error}"])
            else:
                self.save()
                if self.first_run:
                    log(f"recorded {self.repo}#{self.pr}; reporting only new events from now on")
                self.first_run = False
            time.sleep(self.args.interval)


def show(repo: str, number: int, require: list[str] | None) -> None:
    """Print the PR's current state once, with the full text of every open finding."""
    try:
        pr, viewer = fetch(repo, number)
    except GhError as error:
        fail(f"cannot read {repo}#{number}: {error}")
    required = required_check_names(repo, pr["baseRefName"])
    status = analyze(pr, viewer, required, require, set() if require else expected_agents(repo))
    print(f"{repo}#{number} on {status.head[:7]}: {summarize(status, required, require)}")
    for name, check in sorted(status.ci.items()):
        if check.state == "fail":
            print(f"\n[check failed] {name} {check.url}{logs_hint(repo, check.url)}")
    for agent in status.agents:
        verdict = agent.verdict
        if agent.state in ("findings", "failed") and verdict:
            print(f"\n[{agent.agent.name} {agent.state}] {verdict.url}\n{excerpt(verdict.text)}")
        elif agent.state in ("waiting", "failed"):
            print(f"\n[{agent.agent.name} {agent.state}] {request_hint(agent.agent)}")
    print_threads(status)


def print_threads(status: Status) -> None:
    for thread in status.open_threads + status.answered_threads:
        comments = thread["recent"]["nodes"]
        where = f"{thread['path']}:{thread['line']}" if thread["line"] else thread["path"]
        answered = " (answered by you; resolve it)" if thread in status.answered_threads else ""
        print(f"\n[thread {thread['id']}] {where}{answered}")
        for comment in comments[-3:]:
            print(f"  {who(comment)[0]}: {excerpt(comment['body'], 1500)}\n  {comment['url']}")


THREAD_ID = re.compile(r"PRRT_[\w-]+")


def list_threads(repo: str, number: int, as_json: bool) -> None:
    """Print every unresolved review thread with the ID that `reply` and `resolve` take."""
    try:
        pr, viewer = fetch(repo, number)
    except GhError as error:
        fail(f"cannot read {repo}#{number}: {error}")
    status = analyze(pr, viewer, set(), ["none"], set())
    if not as_json:
        print(f"{repo}#{number}: {len(status.open_threads) + len(status.answered_threads)} unresolved threads")
        print_threads(status)
        return
    threads = [
        {
            "id": thread["id"],
            "path": thread["path"],
            "line": thread["line"],
            "answered": thread in status.answered_threads,
            "comments": [{"author": who(c)[0], "body": c["body"], "url": c["url"]} for c in thread["recent"]["nodes"]],
        }
        for thread in status.open_threads + status.answered_threads
    ]
    print(json.dumps(threads, indent=2))


def mutate(query: str, variables: dict[str, str]) -> Json:
    fields = [arg for name, value in variables.items() for arg in ("-f", f"{name}={value}")]
    try:
        body = json.loads(gh("api", "graphql", "-f", f"query={query}", *fields, ok=(0, 1)))
    except (GhError, ValueError) as error:
        fail(f"GitHub rejected the request: {error}", 1)
    if body.get("errors"):
        fail("GitHub rejected the request: " + "; ".join(e.get("message", "") for e in body["errors"]), 1)
    return body["data"]


def reply(thread: str, body: str) -> None:
    """Reply to a review thread. Replies post on the user's behalf, so they must carry the agent marker."""
    if not AGENT_MARK.search(body):
        fail("the reply lacks the agent marker; format it with the comment-on-github skill")
    query = """
    mutation($thread: ID!, $body: String!) {
      addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $thread, body: $body}) { comment { url } }
    }"""
    data = mutate(query, {"thread": thread, "body": body})
    print(data["addPullRequestReviewThreadReply"]["comment"]["url"])


def resolve(threads: list[str]) -> None:
    """Resolve review threads in one request."""
    params = ", ".join(f"$t{i}: ID!" for i in range(len(threads)))
    calls = "\n".join(f"t{i}: resolveReviewThread(input: {{threadId: $t{i}}}) {{ thread {{ id }} }}" for i in range(len(threads)))
    data = mutate(f"mutation({params}) {{\n{calls}\n}}", {f"t{i}": thread for i, thread in enumerate(threads)})
    for i in range(len(threads)):
        print(f"resolved {data[f't{i}']['thread']['id']}")


def duration(text: str) -> float:
    match = re.fullmatch(r"(\d+(?:\.\d+)?)([smh]?)", text.strip())
    if not match:
        raise argparse.ArgumentTypeError(f"'{text}' should look like 30s, 15m, or 1h")
    return float(match.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600}[match.group(2)]


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="monitor-pr",
        usage="monitor-pr [show] <pr> [options]\n       monitor-pr threads list <pr> [--json]\n"
        "       monitor-pr threads reply <thread-id> --body-file <file> [--resolve]\n"
        "       monitor-pr threads resolve <thread-id>...",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("target", nargs="+", metavar="command", help="a PR number or URL, or a command and its arguments")
    parser.add_argument("--repo", help="owner/name (default: from the URL or the current checkout)")
    parser.add_argument("--json", action="store_true", help="threads list: print JSON")
    parser.add_argument("--body-file", help="threads reply: file with the reply, or - for stdin")
    parser.add_argument("--resolve", action="store_true", help="threads reply: resolve the thread after replying")
    parser.add_argument("--until", choices=("ready", "green"), default="ready")
    parser.add_argument("--head", help="ignore the PR until its head is this commit")
    parser.add_argument("--require", type=lambda s: [p.strip() for p in s.split(",") if p.strip()], help="agents that must approve, or none")
    parser.add_argument("--interval", type=duration, default=30.0, help="time between polls (default 30s, min 10s)")
    parser.add_argument("--stall", type=duration, default=900.0, help="quiet time before a review agent counts as stalled (default 15m)")
    args = parser.parse_args()

    if args.target[0] == "threads":
        action, rest = (args.target[1], args.target[2:]) if len(args.target) > 1 else ("", [])
        if action == "list" and len(rest) == 1:
            list_threads(*parse_target(rest[0], args.repo), args.json)
        elif action in ("reply", "resolve") and rest and all(THREAD_ID.fullmatch(t) for t in rest):
            if action == "resolve":
                resolve(rest)
                return
            if len(rest) != 1 or not args.body_file:
                parser.error("threads reply takes one thread ID and --body-file")
            try:
                body = sys.stdin.read() if args.body_file == "-" else Path(args.body_file).read_text()
            except OSError as error:
                parser.error(f"cannot read --body-file: {error}")
            reply(rest[0], body)
            if args.resolve:
                resolve(rest)
        else:
            parser.error("use `threads list <pr>`, `threads reply <thread-id> --body-file <file>`, or `threads resolve <thread-id>...`")
        return

    is_show = args.target[0] == "show"
    rest = args.target[1:] if is_show else args.target
    if len(rest) != 1:
        parser.error("give exactly one PR number or URL")
    if args.head and not re.fullmatch(r"[0-9a-fA-F]{7,40}", args.head):
        parser.error(f"--head '{args.head}' is not a commit SHA")
    args.head = args.head and args.head.lower()
    args.interval = max(args.interval, 10.0)

    repo, number = parse_target(rest[0], args.repo)
    if is_show:
        show(repo, number, args.require)
        return
    _lock = lock(repo, number)
    Watcher(repo, number, args).run()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
